<?xml version="1.0" encoding="utf-8"?>
<!-- 对话框统一表面（P0-3 令牌化）：overlay 底 + 大圆角 + 分隔色细边。
     旧实现用固定 @color/thirdBackgroundColor + px20，随主题切换会割裂；
     现全部走 ?attr 主题令牌，深浅色/七套皮肤自动跟随。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="?attr/tvSurfaceOverlay" />
    <corners android:radius="@dimen/radius_xl" />
    <stroke
        android:width="1dp"
        android:color="?attr/tvDivider" />
</shape>
