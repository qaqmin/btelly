<?xml version="1.0" encoding="utf-8"?>
<!-- 设置行斑马纹背景（P1-4 令牌化）：偶数行卡片 = 抬升表面 + 分隔线细边；
     焦点态 = 强调容器底 + 左侧强调指示条；按压 = 强调容器底。
     旧实现硬编码 #2A2A2A/#3D3D3D/#444444，随主题切换会割裂，现全部走 ?attr。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:exitFadeDuration="@android:integer/config_shortAnimTime">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="?attr/tvAccentDim" />
            <corners android:radius="@dimen/px15" />
        </shape>
    </item>
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape>
                    <solid android:color="?attr/tvAccentDim" />
                    <corners android:radius="@dimen/px15" />
                </shape>
            </item>
            <item android:left="@dimen/px8" android:top="@dimen/px14" android:bottom="@dimen/px14">
                <shape>
                    <solid android:color="?attr/tvAccent" />
                    <corners android:radius="@dimen/px6" />
                    <size android:width="@dimen/px6" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape>
            <solid android:color="?attr/tvSurfaceRaised" />
            <corners android:radius="@dimen/px15" />
            <stroke android:width="@dimen/px2" android:color="?attr/tvDivider" />
        </shape>
    </item>
</selector>
