<?xml version="1.0" encoding="utf-8"?>
<!-- 动态页关注 UP 行背景（P1-5 令牌化）：焦点=强调容器底+圆角，选中=抬升表面+圆角。
     旧实现 list_background 焦点为实心 accent 整行、无圆角，与新体系语言不一致。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:exitFadeDuration="@android:integer/config_shortAnimTime">
    <item android:state_focused="true">
        <shape>
            <solid android:color="?attr/tvAccentDim" />
            <corners android:radius="@dimen/radius_m" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="?attr/tvAccentDim" />
            <corners android:radius="@dimen/radius_m" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape>
            <solid android:color="?attr/tvSurfaceRaised" />
            <corners android:radius="@dimen/radius_m" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@android:color/transparent" />
            <corners android:radius="@dimen/radius_m" />
        </shape>
    </item>
</selector>
