<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/tvSurface">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/button_back"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="@dimen/space_16"
        android:layout_marginTop="@dimen/space_16"
        android:background="@drawable/cell_background"
        android:clickable="true"
        android:focusable="true"
        android:padding="@dimen/space_12"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_back"
        app:tint="?attr/tvTextPrimary" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_12"
        android:layout_marginEnd="@dimen/space_24"
        android:text="@string/collection"
        android:textColor="?attr/tvTextPrimary"
        android:textSize="@dimen/text_title"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/button_back"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/button_back"
        app:layout_constraintTop_toTopOf="@+id/button_back" />

    <!-- 收藏汇总行：把「共 N 个收藏夹 · M 个视频」摆到列表上方。
         必要性：用户的收藏往往高度集中（实测默认收藏夹 1949 条、其余 9 个夹合计 154 条），
         打开小夹子只看到一两条时，会误以为「收藏页里基本没有我的收藏」。
         有总量兜底，一眼就知道那只是其中一个夹。
         嵌入模式（我的页 tab）下 button_back/tv_title 隐藏，本行改挂父容器顶部。 -->
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_summary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_16"
        android:layout_marginTop="@dimen/space_4"
        android:layout_marginEnd="@dimen/space_16"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="?attr/tvTextSecondary"
        android:textSize="@dimen/text_body"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/button_back"
        tools:text="共 10 个收藏夹 · 2103 个视频" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewFavorite"
        android:focusable="false"
        android:descendantFocusability="afterDescendants"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingStart="@dimen/space_12"
        android:paddingTop="@dimen/space_12"
        android:paddingEnd="@dimen/space_12"
        android:paddingBottom="@dimen/space_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_summary" />

    <!-- 统一空态组件（P2-2）：binding.favoriteEmptyState（binding 对象模式） -->
    <include
        android:id="@+id/favorite_empty_state"
        layout="@layout/view_empty_state"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/recyclerViewFavorite"
        app:layout_constraintEnd_toEndOf="@+id/recyclerViewFavorite"
        app:layout_constraintStart_toStartOf="@+id/recyclerViewFavorite"
        app:layout_constraintTop_toTopOf="@+id/recyclerViewFavorite" />

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/recyclerViewFavorite"
        app:layout_constraintEnd_toEndOf="@+id/recyclerViewFavorite"
        app:layout_constraintStart_toStartOf="@+id/recyclerViewFavorite"
        app:layout_constraintTop_toTopOf="@+id/recyclerViewFavorite" />
</androidx.constraintlayout.widget.ConstraintLayout>
