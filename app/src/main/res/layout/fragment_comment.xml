<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/tvSurface">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_comment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:descendantFocusability="afterDescendants"
        android:paddingStart="@dimen/space_12"
        android:paddingTop="@dimen/space_8"
        android:paddingEnd="@dimen/space_12"
        android:paddingBottom="@dimen/space_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 统一空态组件（P2-2） -->
    <include
        android:id="@+id/comment_empty_state"
        layout="@layout/view_empty_state"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/recycler_comment"
        app:layout_constraintEnd_toEndOf="@+id/recycler_comment"
        app:layout_constraintStart_toStartOf="@+id/recycler_comment"
        app:layout_constraintTop_toTopOf="@+id/recycler_comment" />

    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/recycler_comment"
        app:layout_constraintEnd_toEndOf="@+id/recycler_comment"
        app:layout_constraintStart_toStartOf="@+id/recycler_comment"
        app:layout_constraintTop_toTopOf="@+id/recycler_comment" />
</androidx.constraintlayout.widget.ConstraintLayout>
