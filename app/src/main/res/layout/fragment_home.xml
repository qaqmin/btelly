<?xml version="1.0" encoding="utf-8"?>
<!--
  UI 2.0 首页头部：chip 化 tab + 右上时钟。
  tab 文字色由 HomeFragment 按主题令牌设置（color selector 不支持 ?attr）。
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextClock
        android:textSize="@dimen/text_title"
        android:textStyle="bold"
        android:textColor="?attr/tvTextSecondary"
        android:id="@+id/text_clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/home_header_margin_v"
        android:layout_marginEnd="@dimen/home_header_margin_h"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/home_tab_height"
        android:layout_marginStart="@dimen/home_header_margin_h"
        app:layout_constraintBottom_toBottomOf="@+id/text_clock"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/text_clock"
        app:tabGravity="center"
        app:tabIndicator="@null"
        app:tabMaxWidth="@dimen/home_tab_min_width"
        app:tabMinWidth="@dimen/home_tab_min_width"
        app:tabMode="scrollable"
        app:tabTextAppearance="@style/HomeTabChipText"/>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tabLayout"/>
</androidx.constraintlayout.widget.ConstraintLayout>
