<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/tvSurfaceOverlay"
    android:paddingStart="@dimen/space_24"
    android:paddingTop="@dimen/space_20"
    android:paddingEnd="@dimen/space_24"
    android:paddingBottom="@dimen/space_20">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/text_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/danmaku_send_title"
        android:textColor="?attr/tvTextPrimary"
        android:textSize="@dimen/text_title"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 输入框：不用 EditText。遥控器上 EditText 会弹系统输入法，把弹幕输入整个流程
         打断；这里用一个只读 TextView 显示已输入内容，实际输入由 T9/全键盘完成。 -->
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/text_input"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_12"
        android:background="@drawable/bg_search_input"
        android:ellipsize="end"
        android:focusable="true"
        android:gravity="center_vertical"
        android:hint="@string/danmaku_input_hint"
        android:maxLines="1"
        android:minHeight="@dimen/space_48"
        android:paddingStart="@dimen/space_16"
        android:paddingEnd="@dimen/space_16"
        android:textColor="?attr/tvTextPrimary"
        android:textColorHint="?attr/tvTextSecondary"
        android:textSize="@dimen/text_body"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/text_title" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/text_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_4"
        android:textColor="?attr/tvTextSecondary"
        android:textSize="@dimen/text_label"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/text_input" />

    <com.btelly.feature.search.view.KeyboardView
        android:id="@+id/view_keyboard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/text_count" />

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/layout_actions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_12"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view_keyboard">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/button_mode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/button_accent_outline"
            android:focusable="true"
            android:paddingStart="@dimen/space_16"
            android:paddingTop="@dimen/space_8"
            android:paddingEnd="@dimen/space_16"
            android:paddingBottom="@dimen/space_8"
            android:text="@string/danmaku_mode_roll"
            android:textColor="?attr/tvAccent"
            android:textSize="@dimen/text_body"
            app:layout_constraintStart_toStartOf="parent" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/button_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/cell_background"
            android:focusable="true"
            android:paddingStart="@dimen/space_16"
            android:paddingTop="@dimen/space_8"
            android:paddingEnd="@dimen/space_16"
            android:paddingBottom="@dimen/space_8"
            android:text="@string/cancel"
            android:textColor="?attr/tvTextPrimary"
            android:textSize="@dimen/text_body" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/button_send"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_8"
            android:background="@drawable/button_accent_outline"
            android:focusable="true"
            android:paddingStart="@dimen/space_16"
            android:paddingTop="@dimen/space_8"
            android:paddingEnd="@dimen/space_16"
            android:paddingBottom="@dimen/space_8"
            android:text="@string/send"
            android:textColor="?attr/tvAccentOn"
            android:textSize="@dimen/text_body" />
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.constraintlayout.widget.ConstraintLayout>
