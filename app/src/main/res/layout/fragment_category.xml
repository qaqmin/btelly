<?xml version="1.0" encoding="utf-8"?>
<!-- 分类页（P1-5 重做）：tab chip 化与首页同语言（bg_chip + 令牌文字色），
     下划线指示器/旧 TopPageTabText 移除；FrameLayout → ConstraintLayout，
     ViewPager 约束在 tab 下方（旧实现靠 px105 写死偏移，tab 高度一变就错位）。 -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/home_tab_height"
        android:layout_marginStart="@dimen/px30"
        android:layout_marginTop="@dimen/px25"
        android:clipToPadding="false"
        android:paddingStart="@dimen/px30"
        android:paddingEnd="@dimen/px30"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tabGravity="center"
        app:tabIndicator="@null"
        app:tabMaxWidth="@dimen/home_tab_min_width"
        app:tabMinWidth="@dimen/home_tab_min_width"
        app:tabMode="scrollable"
        app:tabTextAppearance="@style/HomeTabChipText" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_8"
        android:descendantFocusability="afterDescendants"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tabLayout" />

</androidx.constraintlayout.widget.ConstraintLayout>
