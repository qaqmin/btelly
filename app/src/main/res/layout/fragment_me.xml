<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:focusable="false"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/home_tab_height"
        android:layout_marginStart="@dimen/px30"
        android:layout_marginTop="@dimen/px25"
        android:layout_marginEnd="@dimen/px30"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tabGravity="center"
        app:tabIndicator="@null"
        app:tabMaxWidth="@dimen/home_tab_min_width"
        app:tabMinWidth="@dimen/home_tab_min_width"
        app:tabMode="fixed"
        app:tabTextAppearance="@style/HomeTabChipText"/>
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:focusable="false"
        android:descendantFocusability="afterDescendants"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tabLayout"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rightStateContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/backgroundColor"
        android:clickable="false"
        android:focusable="false"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- 统一空态组件（P2-2）：ID 并入父 binding（emptyStateImage/emptyStateTitle） -->
        <include layout="@layout/view_empty_state" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
