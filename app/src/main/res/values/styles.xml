        <item name="android:textStyle">bold</item>
        <item name="android:background">@android:color/transparent</item>
    </style>
    <style name="WhiteTheme" parent="@style/Theme.BTellyBase">
        <!-- 浅色族：表面与文字换浅色令牌，accent 加深保证对比度 -->
        <item name="tvSurface">@color/tv_surface_light</item>
        <item name="tvSurfaceRaised">@color/tv_surface_raised_light</item>
        <item name="tvSurfaceOverlay">@color/tv_surface_overlay_light</item>
