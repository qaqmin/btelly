        <item name="android:textSize">@dimen/px48</item>
        <item name="android:textColor">@android:color/white</item>
    </style>


    <!-- Min化：对话框弹簧呈现（运行时 Dialog.applyMinWindowAnim 挂载，Min化 关闭时不挂） -->
    <style name="WindowAnim_MinSpring">
        <item name="android:windowEnterAnimation">@anim/min_dialog_enter</item>
        <item name="android:windowExitAnimation">@anim/min_dialog_exit</item>
    </style>
