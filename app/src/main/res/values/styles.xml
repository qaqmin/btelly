        <item name="android:background">@android:color/transparent</item>
    </style>
    <style name="Theme.BTellyBase" parent="@style/Theme.AppCompat.NoActionBar">
        <!-- 文字与窗口 -->
        <item name="android:textColorPrimary">?attr/tvTextPrimary</item>
        <item name="android:textColorSecondary">?attr/tvTextSecondary</item>
        <item name="android:windowBackground">?attr/tvSurface</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">?attr/tvSurface</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@null</item>
        <item name="android:windowAnimationStyle">@style/WindowAnimationTransition</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- UI 2.0 设计令牌（深色族默认 = 青碧，见 docs/ui-redesign-plan.md） -->
        <item name="tvSurface">@color/tv_surface</item>
        <item name="tvSurfaceRaised">@color/tv_surface_raised</item>
        <item name="tvSurfaceOverlay">@color/tv_surface_overlay</item>
        <item name="tvDivider">@color/tv_divider</item>
        <item name="tvAccent">@color/tv_accent</item>
        <item name="tvAccentDim">@color/tv_accent_dim</item>
        <item name="tvAccentOn">@color/tv_accent_on</item>
        <item name="tvTextPrimary">@color/tv_text_primary</item>
        <item name="tvTextSecondary">@color/tv_text_secondary</item>
        <item name="tvTextTertiary">@color/tv_text_tertiary</item>
        <item name="tvScrim">@color/tv_scrim</item>
        <!-- 旧 attr 兼容映射：未迁移布局自动落入新色系 -->
        <item name="backgroundColor">?attr/tvSurface</item>
        <item name="subBackgroundColor">?attr/tvSurfaceRaised</item>
        <item name="thirdBackgroundColor">?attr/tvSurfaceOverlay</item>
        <item name="fourthBackgroundColor">?attr/tvDivider</item>
        <item name="dividerColor">?attr/tvDivider</item>
        <item name="buttonBackgroundColor">?attr/tvSurfaceOverlay</item>
        <item name="tabBarSelected">?attr/tvTextPrimary</item>
        <item name="tabBarNormal">?attr/tvTextTertiary</item>
        <item name="tabBarHighlight">?attr/tvSurfaceOverlay</item>
        <item name="colorPrimary">?attr/tvAccent</item>
        <item name="colorAccent">?attr/tvAccent</item>
        <item name="colorControlHighlight">?attr/tvAccentDim</item>
        <item name="colorOnPrimary">?attr/tvAccentOn</item>
        <item name="colorOnSecondary">?attr/tvAccentOn</item>
        <item name="colorPrimaryVariant">?attr/tvSurfaceRaised</item>
        <item name="colorSecondary">?attr/tvAccent</item>
        <item name="colorSecondaryVariant">?attr/tvAccentDim</item>
    </style>
    <style name="Theme.BTelly" parent="@style/Theme.BTellyBase">
    </style>
    <style name="Theme.BTelly.Main" parent="@style/Theme.BTellyBase">
        <item name="android:windowAnimationStyle">@style/WindowAnimationNone</item>
        <item name="android:windowNoTitle">true</item>
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
    </style>
