<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Animation.AppCompat.Dialog" parent="@style/Base.Animation.AppCompat.Dialog">
    </style>
    <!-- ===== UI 2.0 导航轨组件样式（view_tab_bar.xml） ===== -->
    <style name="RailNavItem">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/rail_item_height</item>
        <item name="android:layout_marginStart">@dimen/rail_item_margin_h</item>
        <item name="android:layout_marginEnd">@dimen/rail_item_margin_h</item>
        <item name="android:layout_marginTop">@dimen/rail_gap</item>
        <item name="android:background">@drawable/bg_rail_item</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
    <style name="RailIndicator">
        <item name="android:layout_width">@dimen/rail_indicator_width</item>
        <item name="android:layout_height">@dimen/rail_indicator_height</item>
        <item name="android:layout_gravity">start|center_vertical</item>
        <item name="android:background">?attr/tvAccent</item>
        <item name="android:visibility">gone</item>
    </style>
    <style name="RailNavItemContent">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">@dimen/rail_item_margin_h</item>
        <item name="android:paddingEnd">@dimen/rail_item_margin_h</item>
    </style>
    <style name="RailNavIcon">
        <item name="android:layout_width">@dimen/rail_icon_size</item>
        <item name="android:layout_height">@dimen/rail_icon_size</item>
        <item name="android:tint">?attr/tvTextTertiary</item>
    </style>
    <style name="RailNavLabel">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">@dimen/rail_label_margin_start</item>
        <item name="android:layout_weight">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">?attr/tvTextTertiary</item>
        <item name="android:textSize">@dimen/rail_label_size</item>
    </style>
    <style name="BlueTheme" parent="@style/Theme.BTellyBase">
        <item name="tvSurface">@color/tv_surface_blue</item>
        <item name="tvSurfaceRaised">@color/tv_surface_raised_blue</item>
        <item name="tvSurfaceOverlay">@color/tv_surface_overlay_blue</item>
        <item name="tvDivider">@color/tv_divider_blue</item>
        <item name="tvAccent">@color/tv_accent_blue</item>
        <item name="tvAccentDim">@color/tv_accent_dim_blue</item>
        <item name="tvAccentOn">@color/tv_accent_on_blue</item>
    </style>
    <style name="ClassicsTheme" parent="@style/Theme.BTellyBase">
