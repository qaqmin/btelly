        <item name="android:windowSplashScreenBackground" tools:targetApi="31">?attr/tvSurface</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@drawable/ic_brand_splash</item>
        <item name="android:windowSplashScreenIconBackgroundColor" tools:targetApi="31">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@style/WindowAnimationNone</item>
        <item name="android:windowNoTitle">true</item>
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="backgroundColor">@color/tv_surface</item>
